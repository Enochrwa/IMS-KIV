# Kivunova IMS Container App - Environment Variables
# Copy this file to .env.local and configure your values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Application environment (development, staging, production)
VITE_APP_ENVIRONMENT=development

# Enable debug mode
VITE_APP_DEBUG=true

# Application version
VITE_APP_VERSION=1.0.0

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Base API URL
VITE_API_BASE_URL=http://localhost:4000/api

# GraphQL endpoint
VITE_GRAPHQL_ENDPOINT=http://localhost:4000/graphql

# GraphQL WebSocket endpoint for subscriptions
VITE_GRAPHQL_WS_ENDPOINT=ws://localhost:4000/graphql

# API timeout in milliseconds
VITE_API_TIMEOUT=30000

# Number of retry attempts for failed API calls
VITE_API_RETRY_ATTEMPTS=3

# =============================================================================
# MICRO FRONTEND CONFIGURATION
# =============================================================================

# Products & Catalog MFE
VITE_MFE_PRODUCTS_URL=http://localhost:3001

# Inventory Management MFE
VITE_MFE_INVENTORY_URL=http://localhost:3002

# Orders Management MFE
VITE_MFE_ORDERS_URL=http://localhost:3003

# User & Role Management MFE
VITE_MFE_USERS_URL=http://localhost:3004

# Reports & Analytics MFE
VITE_MFE_REPORTS_URL=http://localhost:3005

# Store Settings MFE
VITE_MFE_SETTINGS_URL=http://localhost:3006

# MFE timeout in milliseconds
VITE_MFE_TIMEOUT=10000

# Number of retry attempts for failed MFE loads
VITE_MFE_RETRY_ATTEMPTS=2

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# Local storage key for auth token
VITE_AUTH_TOKEN_KEY=kivu_auth_token

# Local storage key for refresh token
VITE_AUTH_REFRESH_TOKEN_KEY=kivu_refresh_token

# Minutes before token expiry to refresh
VITE_AUTH_TOKEN_EXPIRY_BUFFER=5

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Prefix for local storage keys
VITE_STORAGE_PREFIX=kivu_ims_

# Encryption key for sensitive data (optional)
VITE_STORAGE_ENCRYPTION_KEY=

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable multi-language support
VITE_FEATURE_MULTI_LANGUAGE=true

# Enable dark mode
VITE_FEATURE_DARK_MODE=true

# Enable notifications
VITE_FEATURE_NOTIFICATIONS=true

# Enable audit logs
VITE_FEATURE_AUDIT_LOGS=true

# Enable real-time updates
VITE_FEATURE_REAL_TIME_UPDATES=true

# Enable offline mode
VITE_FEATURE_OFFLINE_MODE=false

# Enable PWA support
VITE_FEATURE_PWA_SUPPORT=false

# Enable analytics
VITE_FEATURE_ANALYTICS=false

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Sentry DSN for error tracking
VITE_SENTRY_DSN=

# Google Analytics tracking ID
VITE_GOOGLE_ANALYTICS_ID=

# Intercom app ID for customer support
VITE_INTERCOM_APP_ID=

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Cache TTL in seconds
VITE_CACHE_TTL=300

# Maximum concurrent requests
VITE_MAX_CONCURRENT_REQUESTS=10

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Content Security Policy nonce
VITE_CSP_NONCE=

# Allowed origins (comma-separated)
VITE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Build version
VITE_BUILD_VERSION=1.0.0-dev

# Deployment URL
VITE_DEPLOYMENT_URL=http://localhost:5173

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable React DevTools
VITE_REACT_DEVTOOLS=true

# Enable Redux DevTools
VITE_REDUX_DEVTOOLS=true

# Enable verbose logging
VITE_VERBOSE_LOGGING=false

# Mock API responses
VITE_MOCK_API=false

# =============================================================================
# STAGING ENVIRONMENT OVERRIDES
# =============================================================================

# Uncomment and modify for staging environment
# VITE_API_BASE_URL=https://api-staging.kivunova.com/api
# VITE_GRAPHQL_ENDPOINT=https://api-staging.kivunova.com/graphql
# VITE_MFE_PRODUCTS_URL=https://products-staging.kivunova.com
# VITE_MFE_INVENTORY_URL=https://inventory-staging.kivunova.com
# VITE_MFE_ORDERS_URL=https://orders-staging.kivunova.com
# VITE_MFE_USERS_URL=https://users-staging.kivunova.com
# VITE_MFE_REPORTS_URL=https://reports-staging.kivunova.com
# VITE_MFE_SETTINGS_URL=https://settings-staging.kivunova.com
# VITE_DEPLOYMENT_URL=https://app-staging.kivunova.com

# =============================================================================
# PRODUCTION ENVIRONMENT OVERRIDES
# =============================================================================

# Uncomment and modify for production environment
# VITE_APP_DEBUG=false
# VITE_API_BASE_URL=https://api.kivunova.com/api
# VITE_GRAPHQL_ENDPOINT=https://api.kivunova.com/graphql
# VITE_MFE_PRODUCTS_URL=https://products.kivunova.com
# VITE_MFE_INVENTORY_URL=https://inventory.kivunova.com
# VITE_MFE_ORDERS_URL=https://orders.kivunova.com
# VITE_MFE_USERS_URL=https://users.kivunova.com
# VITE_MFE_REPORTS_URL=https://reports.kivunova.com
# VITE_MFE_SETTINGS_URL=https://settings.kivunova.com
# VITE_DEPLOYMENT_URL=https://app.kivunova.com
# VITE_FEATURE_ANALYTICS=true
# VITE_FEATURE_PWA_SUPPORT=true
# VITE_FEATURE_OFFLINE_MODE=true
