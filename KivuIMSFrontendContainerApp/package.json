{
  "name": "kivuimsuicontainerapp",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "postbuild": "npm run lint && npm run format:check && npm run test && echo 'Build successful'",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist coverage node_modules build",
    "dev": "vite",
    "extract-translations": "node scripts/extract-translations.js",
    "format": "prettier \"*.{js,json,ts}\" \"app/**/*.{js,jsx,ts,tsx,json,css,scss}\" --write",
    "format:check": "prettier \"*.{js,json,ts}\" \"app/**/*.{js,jsx,ts,tsx,json,css,scss}\" --check",
    "heroku-postbuild": "npm run build",
    "lint": "eslint \"*.js\" \"app/**/*.{ts,tsx,js,jsx}\" && npm run sort-package",
    "lint:fix": "eslint \"*.js\" \"app/**/*.{ts,tsx,js,jsx}\" --fix",
    "prepare": "husky",
    "preview": "vite preview",
    "sort-package": "sort-package-json",
    "start": "serve -s dist -l $PORT",
    "test": "NODE_ENV=test jest --coverage",
    "test:ci": "NODE_ENV=test jest --coverage",
    "test:update": "jest --updateSnapshot",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@kivunova/kivufrontendcommon": "^1.13.0",
    "@module-federation/utilities": "^3.1.69",
    "@mui/icons-material": "^7.3.1",
    "@mui/lab": "^7.0.1-beta.18",
    "@mui/material": "^7.3.1",
    "@mui/x-charts": "^8.10.0",
    "@reduxjs/toolkit": "^2.9.0",
    "@tanstack/react-query": "^5.87.4",
    "date-fns": "^4.1.0",
    "dotenv-expand": "^12.0.3",
    "framer-motion": "^12.23.24",
    "i18next": "^25.3.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "install": "^0.13.0",
    "isbot": "^5.1.27",
    "libphonenumber-js": "^1.12.17",
    "npm": "^11.6.0",
    "react": "^18.3.1",
    "react-date-range": "^2.0.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.63.0",
    "react-i18next": "^15.6.1",
    "react-redux": "^9.2.0",
    "react-router": "^7.7.1",
    "react-router-dom": "^7.8.0",
    "serve": "^14.2.5",
    "typescript-eslint": "^8.43.0",
    "yup": "^1.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.35.0",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react": "^5.0.2",
    "babel-jest": "^29.7.0",
    "cross-env": "^10.0.0",
    "dotenv": "^17.2.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-webpack-plugin": "^5.0.2",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-resolve": "^30.1.3",
    "jest-watch-typeahead": "^2.2.1",
    "prettier": "^3.6.2",
    "sort-package-json": "^3.4.0",
    "tailwindcss": "^4.1.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^6.4.1",
    "vite-tsconfig-paths": "^5.1.4",
    "whatwg-fetch": "^3.6.20"
  },
  "engines": {
    "node": "20.x"
  }
}
